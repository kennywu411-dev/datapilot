# 复制为 .env 后填写。.env 不进 git、不进代码包。
ANTHROPIC_API_KEY=
# 可选：Redis 地址，连不上时自动退回内存存储
REDIS_URL=redis://localhost:6379/0
# 可选：问数界面使用的模型（haiku / sonnet / opus）
DATAPILOT_MODEL=sonnet
# 可选：国产 API 模型（D1 对比评测用，OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# 可选：覆盖模型 ID（默认 deepseek-flash / qwen-plus，以厂商 /models 返回为准）
DEEPSEEK_MODEL=
QWEN_MODEL=
